---
import { getTools } from '../lib/repos';
import '../styles.css';
const tools = await getTools();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet" />
    <title>Gob's Jobs</title>
    <meta name="description" content="Free tools and trackers made by TheGobOne." />
  </head>
  <body>
    <header>
      <h1>Gob's Jobs</h1>
      <p>Free tools I built for myself that I think the community might use as well.</p>
    </header>
    <main>
      <ul class="grid">
        {tools.map((t) => (
          <li class="card">
            <h2>{t.title}</h2>
            {t.description && <p>{t.description}</p>}
            <div class="links">
              {t.live && <a class="btn primary" href={t.live} target="_blank" rel="noopener">Open tool</a>}
              {t.links.map((l) => <a class="btn primary" href={l.url} rel="noopener">{l.label}</a>)}
              <a class="btn" href={t.github} rel="noopener">GitHub</a>
            </div>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
